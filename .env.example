# Football Intelligence OS — DEVELOPMENT template.
# Copy to .env for local work. Never commit .env (it is gitignored).
# Per-environment templates live in deploy/env/*.env.example; staging and
# production refuse to start with any of the development defaults below
# (app/phase17/environments.py, enforced at startup).

# development | test | staging | production. Production is never implied:
# a missing value means development.
ENVIRONMENT=development

# --- Database (one database per environment; never shared) ---
DATABASE_URL=postgresql+asyncpg://fios:fios@localhost:5432/fios

# --- Cache / queue (use a distinct Redis DB index or host per environment) ---
REDIS_URL=redis://localhost:6379/0

# --- Raw snapshot storage ---
# local | s3. Staging/production require s3.
SNAPSHOT_STORAGE_BACKEND=local
SNAPSHOT_STORAGE_PATH=./data/bronze

# Only read when SNAPSHOT_STORAGE_BACKEND=s3.
# Running the app directly on the host against `docker compose up` MinIO:
#   S3_ENDPOINT=http://localhost:9000
# Running the app AS a container in the same compose network (see
# docker-compose.yml's `api` service, which sets this for you already):
#   S3_ENDPOINT=http://minio:9000
S3_BUCKET=football-os-bronze
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fios
S3_SECRET_KEY=fios12345
S3_REGION=us-east-1

# --- Model artifacts (one directory/bucket per environment) ---
MODEL_ARTIFACT_DIR=./data/models

# --- HTTP ---
# Comma-separated. "*" is rejected in staging/production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=120

# --- Provider credentials (leave empty unless you have a real key) ---
# API-Football. Get a key from: https://dashboard.api-football.com/profile?access
# (the API request host is v3.football.api-sports.io, NOT www.api-football.com —
# that's the docs/dashboard site, not the API)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# football-data.org: implemented, tested, NOT active by default (ADR-008).
# To re-enable: set these two, then call
# app.providers.registry.register_optional_providers(your_registry).
# FOOTBALL_DATA_TOKEN=
# FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

PROVIDER_PROBE_TIMEOUT_S=15

# --- Notifications (a channel is only enabled when configured) ---
# IN_APP always works (database rows). EMAIL and WEBHOOK stay UNAVAILABLE
# until one of these is set.
# NOTIFICATION_WEBHOOK_URL=
# NOTIFICATION_SMTP_URL=
