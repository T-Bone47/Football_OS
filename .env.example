ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fios:fios@localhost:5432/fios

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Raw snapshot storage ---
# local | s3
SNAPSHOT_STORAGE_BACKEND=local
SNAPSHOT_STORAGE_PATH=./data/bronze

# Only read when SNAPSHOT_STORAGE_BACKEND=s3.
# Running the app directly on the host against `docker compose up` MinIO:
#   S3_ENDPOINT=http://localhost:9000
# Running the app AS a container in the same compose network (see
# docker-compose.yml's `api` service, which sets this for you already):
#   S3_ENDPOINT=http://minio:9000
S3_BUCKET=football-os-bronze
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fios
S3_SECRET_KEY=fios12345
S3_REGION=us-east-1

# --- Provider credentials ---
# Leave blank in development. Never commit real values.
# Get keys from: https://www.api-football.com/  and  https://www.football-data.org/
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=
