ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fios:fios@localhost:5432/fios

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Raw snapshot storage ---
# local | s3
SNAPSHOT_STORAGE_BACKEND=local
SNAPSHOT_STORAGE_PATH=./data/bronze

# Only read when SNAPSHOT_STORAGE_BACKEND=s3.
# Running the app directly on the host against `docker compose up` MinIO:
#   S3_ENDPOINT=http://localhost:9000
# Running the app AS a container in the same compose network (see
# docker-compose.yml's `api` service, which sets this for you already):
#   S3_ENDPOINT=http://minio:9000
S3_BUCKET=football-os-bronze
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fios
S3_SECRET_KEY=fios12345
S3_REGION=us-east-1

# --- Provider credentials ---
# API-Football is the only active provider right now (see ADR-008).
# Get a key from: https://dashboard.api-football.com/profile?access
# (the API request host is v3.football.api-sports.io, NOT www.api-football.com —
# that's the docs/dashboard site, not the API)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Free plan: 10 requests/minute. Paginated ingestion waits between pages.
API_FOOTBALL_PAGE_DELAY_SECONDS=6.1
API_FOOTBALL_MAX_PAGES_PER_RUN=200
# Canonical API pagination bounds (UI is page-driven).
PLAYERS_DEFAULT_PAGE_SIZE=25
PLAYERS_MAX_PAGE_SIZE=100

# football-data.org: implemented, tested, NOT active by default (ADR-008).
# To re-enable: set these two, then call
# app.providers.registry.register_optional_providers(your_registry).
# FOOTBALL_DATA_TOKEN=
# FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# --- StatsBomb Open Data ---
# Free, no key, CC BY-NC-SA 4.0 — used for event analytics / role-discovery validation,
# not as a primary fixture/lineup source. Attribution: https://github.com/statsbomb/open-data
STATSBOMB_ENABLED=true
STATSBOMB_MODE=open_data
STATSBOMB_OPEN_DATA_REPOSITORY=https://github.com/hudl/open-data
STATSBOMB_OPEN_DATA_BRANCH=master
STATSBOMB_LOCAL_DATA_DIR=data/bronze/statsbomb-open-data

# --- Database expansion runner ---
# The runner reads the provider's own budget (GET /status: requests.current /
# requests.limit_day). These are local safety valves.
INGESTION_REQUEST_INTERVAL_SECONDS=6.5
# 0 = no local cap; the provider's daily budget still applies.
INGESTION_MAX_REQUESTS_PER_RUN=0
# The API-Football Free plan rejects page > 3 on every paginated endpoint.
INGESTION_PLAN_PAGE_CAP=3
# Coverage targets are configuration, not code.
INGESTION_PRIORITY_LEAGUES_PATH=data/registry/priority_leagues.json
# Dated country-priority snapshot (FIFA Men's World Ranking).
INGESTION_COUNTRY_SNAPSHOT_PATH=data/registry/country_priority_snapshot_2026-10-07.json

# --- Supplementary providers (registered, disabled) ---
# OpenLigaDB: German league fixtures/results/standings, no player data.
OPENLIGADB_BASE_URL=https://api.openligadb.de/
# TheSportsDB: descriptive metadata only; must never overwrite a stronger fact.
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api.php
# THESPORTSDB_KEY=

# --- LLM Provider Configuration ---
# Active LLM provider: "groq" | "huggingface" | "openai" | "anthropic" | "gemini" | "none"
LLM_PROVIDER=groq
# Explicit model ID for the active provider (e.g., openai/gpt-oss-120b for Groq, openai/gpt-oss-120b for HF)
LLM_MODEL=openai/gpt-oss-120b

# Optional fallback provider (only used when explicitly enabled and primary fails)
LLM_FALLBACK_PROVIDER=huggingface
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# Runtime controls
LLM_ALLOW_PAID_FALLBACK=false
LLM_ALLOW_LOCAL_FALLBACK=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_ENABLE_STREAMING=true
# --- Grounded assistant budgets ---
# The provider's per-minute token budget is the binding constraint on a turn
# (planning request + answer request), so the number of tool schemas offered to
# the model and the size of the tool results are configurable.
LLM_MAX_TOOL_SCHEMAS=12
LLM_MAX_TOOL_CALLS=8
LLM_MAX_TOOL_ROUNDS=4
LLM_TOOL_TIMEOUT_SECONDS=20
LLM_CONTEXT_BUDGET_CHARS=6000

# Groq (OpenAI-compatible API) - https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Hugging Face Inference Providers - https://huggingface.co/settings/tokens
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
