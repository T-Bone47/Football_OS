# STAGING environment template. Values in ${...} come from the secret
# manager at deploy time; never write a real secret into this file.
# Hostnames ending in .internal / .example.invalid are placeholders.
ENVIRONMENT=staging
DATABASE_URL=postgresql+asyncpg://fios_staging:${STAGING_DB_PASSWORD}@staging-db.internal:5432/fios_staging
REDIS_URL=redis://staging-cache.internal:6379/0
SNAPSHOT_STORAGE_BACKEND=s3
SNAPSHOT_STORAGE_PATH=
S3_BUCKET=football-os-bronze-staging
S3_ACCESS_KEY=${STAGING_S3_ACCESS_KEY}
S3_SECRET_KEY=${STAGING_S3_SECRET_KEY}
MODEL_ARTIFACT_DIR=s3://football-os-models-staging
CORS_ALLOWED_ORIGINS=https://staging.example.invalid
API_FOOTBALL_KEY=${STAGING_API_FOOTBALL_KEY}
