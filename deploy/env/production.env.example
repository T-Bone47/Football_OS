# PRODUCTION environment template. Values in ${...} come from the secret
# manager at deploy time; never write a real secret into this file.
# Hostnames ending in .internal / .example.invalid are placeholders.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://fios_prod:${PRODUCTION_DB_PASSWORD}@prod-db.internal:5432/fios_production
REDIS_URL=redis://prod-cache.internal:6379/0
SNAPSHOT_STORAGE_BACKEND=s3
SNAPSHOT_STORAGE_PATH=
S3_BUCKET=football-os-bronze-production
S3_ACCESS_KEY=${PRODUCTION_S3_ACCESS_KEY}
S3_SECRET_KEY=${PRODUCTION_S3_SECRET_KEY}
MODEL_ARTIFACT_DIR=s3://football-os-models-production
CORS_ALLOWED_ORIGINS=https://app.example.invalid
API_FOOTBALL_KEY=${PRODUCTION_API_FOOTBALL_KEY}
