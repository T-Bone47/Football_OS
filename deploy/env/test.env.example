# TEST environment template. Values in ${...} come from the secret
# manager at deploy time; never write a real secret into this file.
# Hostnames ending in .internal / .example.invalid are placeholders.
ENVIRONMENT=test
DATABASE_URL=postgresql+asyncpg://fios:fios@localhost:5432/fios_test
REDIS_URL=redis://localhost:6379/1
SNAPSHOT_STORAGE_BACKEND=local
SNAPSHOT_STORAGE_PATH=./data/bronze-test
S3_BUCKET=
S3_ACCESS_KEY=${TEST_S3_ACCESS_KEY}
S3_SECRET_KEY=${TEST_S3_SECRET_KEY}
MODEL_ARTIFACT_DIR=./data/models-test
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_FOOTBALL_KEY=${TEST_API_FOOTBALL_KEY}
