# DEVELOPMENT environment template. Values in ${...} come from the secret
# manager at deploy time; never write a real secret into this file.
# Hostnames ending in .internal / .example.invalid are placeholders.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://fios:fios@localhost:5432/fios
REDIS_URL=redis://localhost:6379/0
SNAPSHOT_STORAGE_BACKEND=local
SNAPSHOT_STORAGE_PATH=./data/bronze
S3_BUCKET=
S3_ACCESS_KEY=${DEVELOPMENT_S3_ACCESS_KEY}
S3_SECRET_KEY=${DEVELOPMENT_S3_SECRET_KEY}
MODEL_ARTIFACT_DIR=./data/models
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_FOOTBALL_KEY=${DEVELOPMENT_API_FOOTBALL_KEY}
